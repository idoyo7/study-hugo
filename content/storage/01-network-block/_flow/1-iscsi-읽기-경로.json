{
  "caption": "iSCSI로 내보낸 블록 장치에 읽기 요청 하나가 닿기까지 지나는 계층입니다. 위쪽 줄이 요청을 만드는 호스트(initiator), 아래쪽 줄이 장치를 가진 서버(target)이고, 둘 사이의 세로 화살표가 네트워크 구간입니다.",
  "font": 1.1,
  "nodes": [
    { "id": "FS", "col": 0, "row": 0, "label": "파일시스템", "sub": "VFS 아래", "kind": "src" },
    { "id": "BLK", "col": 1, "row": 0, "label": "블록 계층", "sub": "blk-mq", "kind": "proc" },
    { "id": "SCSI", "col": 2, "row": 0, "label": "SCSI 중간 계층", "sub": "sd · scsi-mq", "kind": "proc" },
    { "id": "INI", "col": 3, "row": 0, "label": "iSCSI initiator", "sub": "iscsi_tcp → TCP", "kind": "proc" },
    { "id": "TGT", "col": 3, "row": 2, "label": "iSCSI target", "sub": "TCP → LIO", "kind": "proc" },
    { "id": "BS", "col": 2, "row": 2, "label": "backstore", "sub": "block · fileio 등", "kind": "proc" },
    { "id": "DEV", "col": 1, "row": 2, "label": "로컬 블록 장치", "sub": "예: NVMe SSD", "kind": "store" }
  ],
  "edges": [
    { "from": "FS", "to": "BLK", "label": "블록 요청", "rate": 600 },
    { "from": "BLK", "to": "SCSI", "label": "요청", "rate": 600 },
    { "from": "SCSI", "to": "INI", "label": "CDB", "rate": 600 },
    { "from": "INI", "to": "TGT", "label": "PDU · TCP", "rate": 600 },
    { "from": "TGT", "to": "BS", "label": "LUN", "rate": 600 },
    { "from": "BS", "to": "DEV", "label": "블록 I/O", "rate": 600 }
  ],
  "groups": [
    { "id": "host", "label": "initiator 호스트", "members": ["FS", "BLK", "SCSI", "INI"] },
