    { "id": "ec2_sentinel", "col": 0, "row": 1, "label": "EC2 Sentinel", "sub": "3→4대(총 7)", "kind": "src" },
    { "id": "nlb_sentinel", "col": 1, "row": 1, "label": "NLB 리스너", "sub": ":26380", "kind": "proc" },
    { "id": "tg_sentinel", "col": 2, "row": 1, "label": "타깃 그룹", "sub": "전 노드 · nodePort :31001", "kind": "proc" },
